{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++-13 build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-arch",
                "arm64",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Run Verilog",
            "type": "shell",
            "command": "iverilog",
            "args": [
                "-o",
                "output.vvp",
                "tanh_initializer_tb.v",
                "tanh_initializer.v"
                // "atanh_constants_tb.v", // Testbench file

                // "tb_top_level.v",
                // "top_level.v",
                // "atanh_rom.v",
                // "scaling_rom.v"

                // "convolver_tb.v",
                // "convolver.v",
                // "mac_unit.v"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Simulate Verilog",
            "type": "shell",
            "command": "vvp",
            "args": [
                "output.vvp"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}

